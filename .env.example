# Copy to .env and fill in. Never commit real credentials or expose them via NEXT_PUBLIC_*.
# Local Postgres from docker-compose.yml; use Neon pooled/direct URLs when deployed.
DATABASE_URL=postgres://commoncart:commoncart@localhost:54329/commoncart
DATABASE_DIRECT_URL=postgres://commoncart:commoncart@localhost:54329/commoncart
TEST_DATABASE_URL=postgres://commoncart:commoncart@localhost:54329/commoncart_test
APP_ORIGIN=http://localhost:3000
PROVIDER_MODE=rehearsal
DEMO_CONTROLS_ENABLED=true

# Sponsor mode (unverified until `npm run verify:sponsors` records evidence in techContext.md)
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
NESSIE_API_KEY=
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=COMMONCART
SNOWFLAKE_SCHEMA=DEMO
SNOWFLAKE_MODEL=claude-haiku-4-5
RUN_LIVE_SPONSOR_CHECKS=false
