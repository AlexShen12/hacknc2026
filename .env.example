# Copy to .env.local for local development. Keep real credentials out of this file.
# Neon Console → Connect: pooled URL for the app, direct URL for migrations.
DATABASE_URL=
DATABASE_DIRECT_URL=

# Local test database from docker-compose.yml; change only if the compose config changes.
TEST_DATABASE_URL=postgresql://commoncart:commoncart@localhost:54329/commoncart_test

APP_ORIGIN=http://localhost:3000
PROVIDER_MODE=rehearsal
DEMO_CONTROLS_ENABLED=true

# Sponsor mode. Use values supplied/approved for the HackNC integrations.
NESSIE_BASE_URL=
NESSIE_API_KEY=
# Full URL, including https:// (copy Account/Server URL from Snowflake).
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=
# Replace these example names with a least-privilege role and usable warehouse.
SNOWFLAKE_ROLE=COMMONCART_APP
SNOWFLAKE_WAREHOUSE=COMMONCART_WH
SNOWFLAKE_DATABASE=COMMONCART
SNOWFLAKE_SCHEMA=DEMO
SNOWFLAKE_MODEL=claude-haiku-4-5
RUN_LIVE_SPONSOR_CHECKS=false
